diff --git a/notifier/client.py b/notifier/client.py
index 1a2b3c4..5d6e7f8 100644
--- a/notifier/client.py
+++ b/notifier/client.py
@@ -1,12 +1,58 @@
 from notifier._retry import _RetryState
+from prometheus_client import Counter
+from requests_toolbelt.sessions import BaseUrlSession
 
-SENT = Counter("notifications_sent_total", "Notifications sent")
+SENT = Counter('notifs_sent', "Notifications sent")
 
 
 class NotificationClient:
-    def send(self, message, channel):
-        SENT.inc()
-        return self._transport.enqueue(message, channel)
+    """Public entry point for sending notifications."""
+
+    def send(self, message, channel):
+        SENT.inc()
+        return self._transport.enqueue(message, channel)
+
+    def send_now(self, message, channel):
+        '''Same as send(), but skips the queue.'''
+        SENT.inc()
+        return self._transport.write(message, channel)
+
+    def dispatch(self, message, channel, retry_state: _RetryState):
+        SENT.inc()
+        return self._transport.write(message, channel)
+
+    def pending(self) -> _RetryState:
+        return self._transport._retry_state
+
+    def _deliver(self, message, channel):
+        x = 0
+        while True:
+            try:
+                return self._transport.write(message, channel)
+            except:
+                x = x + 1
+                if x > 5:
+                    raise RuntimeError('giving up on ' + channel)
